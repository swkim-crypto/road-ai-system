# Anthropic Claude API Key
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-api03-...

# Kakao JavaScript Key
# https://developers.kakao.com 에서 앱 생성 후 발급
# Web 플랫폼에 Render 도메인 등록 필수
KAKAO_JS_KEY=your_kakao_js_key_here

# 허용 Origin (Render 배포 도메인)
ALLOWED_ORIGIN=https://your-app-name.onrender.com

# 서버 포트 (Render가 자동 설정하므로 건드리지 않아도 됨)
PORT=3000
